<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="turbo-visit-control" content="reload">
    <title><%= content_for?(:title) ? yield(:title) : "Admin" %> - <%= Madmin.site_name %> Admin</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# An app that ejected views builds its own madmin.js; everyone else gets the gem's prebuilt bundle. %>
    <% own_bundle = begin; asset_path("madmin.js"); true; rescue StandardError; false; end %>
    <%= stylesheet_link_tag "madmin_inertia" %>
    <% if own_bundle %>
      <%= stylesheet_link_tag "application" %>
      <%= javascript_include_tag "madmin", type: "module" %>
    <% else %>
      <%= javascript_include_tag "madmin_inertia", type: "module" %>
    <% end %>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
