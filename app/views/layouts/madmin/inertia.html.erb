<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="turbo-visit-control" content="reload">
    <title><%= content_for?(:title) ? yield(:title) : "Admin" %> - <%= Madmin.site_name %> Admin</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application" %>
    <% begin %>
      <%= javascript_include_tag "madmin", type: "module" %>
    <% rescue => error %>
      <% raise error, "#{error.message}\n\nmadmin_inertia loads app/javascript/madmin.jsx as madmin.js. Run `rails g madmin_inertia:install`, then `pnpm build` (or bin/dev).", error.backtrace %>
    <% end %>
  </head>
  <body>
    <%= yield %>
  </body>
</html>
